{
  "name": "cloudvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build:dev-api && concurrently -k -n api,build,web \"node --env-file-if-exists=.env --watch .cloudvault-dev/server.mjs\" \"npm run build:dev-api -- --watch\" \"vite\"",
    "build:dev-api": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=.cloudvault-dev/server.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "build:windows": "npm run build && node windows/package.mjs",
    "test": "esbuild \"tests/*.test.ts\" --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist/tests && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.12",
    "@noble/hashes": "^2.0.1",
    "@zip.js/zip.js": "^2.8.10",
    "big-integer": "^1.6.52",
    "fastify": "^5.6.2",
    "hash-wasm": "^4.12.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.14.1",
    "telegram": "^2.26.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0"
  }
}
